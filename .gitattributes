# Custom scss themes get rendered to css
*.scss  linguist-detectable=true
*.css   linguist-detectable=false

# Hand-written files under docs/ (the site's build scripts, theme sources and the vendored
# Sass/CSS they compile against): override Linguist's documentation heuristic, which
# otherwise excludes anything under docs/ from language stats.
docs/*.jl linguist-documentation=false
docs/src/assets/themes/*.scss linguist-documentation=false

# docs/src/assets/themes/<name>.css is the compiled output of <name>.scss (written by
# docs/compile_themes.jl, never edited by hand); docs/scss/highlightjs/github.css is vendored.
# docs/scss/flatly (bulmaswatch, MIT) is vendored too. All three stay out of the language stats.
docs/src/assets/themes/*.css linguist-generated=true
docs/scss/highlightjs/*.css linguist-vendored=true
docs/scss/flatly/* linguist-vendored=true

# Everything under test/ is hand-written code and counts in the language stats (Julia,
# TOML), including each test environment's Project.toml; only the Manifest.toml
# files, which are generated, stay out. Overrides Linguist's documentation heuristic.
test/** linguist-documentation=false
test/**/*.jl linguist-detectable=true
test/**/Project.toml linguist-detectable=true linguist-generated=false

# TOMLs: every Project.toml (root, docs/, test/ and its environments, dev/ and dev/test/) and
# CondaPkg.toml is hand-written and counts; every Manifest.toml is generated and stays out.
*.toml linguist-detectable=true
Project.toml linguist-detectable=true linguist-generated=false
CondaPkg.toml linguist-detectable=true linguist-generated=false
Manifest.toml linguist-generated=true linguist-detectable=false
docs/Project.toml linguist-documentation=false

# Ignore generated .tex files.
*.tex linguist-generated=true

# The TUI's ASCII art (the page files under tui/resources): trailing spaces are part of
# the picture, so `git diff --check` (and `bysl precommit`'s whitespace step, which strips
# what it reports) must leave them alone.
tui/resources/**/*.txt whitespace=-trailing-space

# The dev tools (the Julia package in dev/ with its tests, the launcher and the scripts beside
# them) and the TypeScript code are hand-written and count in the language stats, each
# environment's Project.toml included; only the Manifest.toml files, which are generated, stay
# out. Overrides Linguist's documentation heuristic.
dev/** linguist-documentation=false
dev/**/*.jl linguist-detectable=true
dev/**/Project.toml linguist-detectable=true linguist-generated=false
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
*.d.ts linguist-detectable=true linguist-generated=false

# (after the TOML rules above, which would otherwise win) test/ Manifests stay out of the stats.
test/**/Manifest.toml linguist-generated=true linguist-detectable=false

# Linguist treats everything under test/fixtures/ as vendored (default rule
# `(^|/)[Tt]ests?/fixtures/`), which also hides these two hand-written code fixtures.
test/fixtures/molecules/sequences.jl linguist-vendored=false linguist-detectable=true

# (after the TOML rules above) the Manifests of dev/ stay out of the stats too.
dev/**/Manifest.toml linguist-generated=true linguist-detectable=false
