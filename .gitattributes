*.scss  linguist-detectable=true
*.css   linguist-detectable=false

# Hand-written; override Linguist's documentation heuristic, which
# otherwise excludes anything under docs/ from language stats.
docs/src/assets/themes/*.scss linguist-documentation=false

# documenter-light.css / documenter-dark.css are compiled output of academic.scss /
# academic-dark.scss, not hand-authored; they stay excluded from language stats.
docs/src/assets/themes/documenter-*.css linguist-generated=true

# The Tcl tools' tcltest files are Tcl.
*.test  linguist-language=Tcl
