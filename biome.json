{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "files": {
        "includes": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "!**/node_modules", "!docs/build"]
    },
    "formatter": { "enabled": false },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": { "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "requireAscii": false,
                        "conventions": [
                            {
                                "selector": { "kind": "objectLiteralProperty" },
                                "formats": ["camelCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": { "kind": "importNamespace" },
                                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                            }
                        ]
                    }
                } }
        }
    }
}
