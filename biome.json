{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "files": {
        "includes": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "!**/node_modules", "!docs/build"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 92,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": { "preset": "recommended" }
    },
    "javascript": {
        "formatter": { "quoteStyle": "double", "semicolons": "always" }
    }
}
