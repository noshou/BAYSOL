;; The TUI is plain Clojure on the JVM (the dev tools in ../dev stay Babashka).
;; Run it from this folder: `clojure -M:run`. Dependencies come from Maven
;; Central and Clojars, so there are no jars to keep in the tree.
{:paths ["src" "resources"],
 :deps {org.clojure/clojure {:mvn/version "1.12.0"},
  com.googlecode.lanterna/lanterna {:mvn/version "3.1.5"},
  doric/doric {:mvn/version "0.9.0"}},
 :aliases {:run {:main-opts ["-m" "baysol.tui.core"]},
  :test {
   :extra-paths ["test"],
   :extra-deps {io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1", :git/sha "dfb30dd"}},
   :main-opts ["-m" "cognitect.test-runner"]}}}
