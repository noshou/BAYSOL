{
  "name": "baysol-tui",
  "type": "module",
  "version": "1.0.0",
  "description": "The terminal interface of BAYSOL (TypeScript, Ink): make projects, add models and a buffer, edit settings, all from the keyboard. Runs in any terminal of at least 80 x 24; looks best with 24-bit colour.",
  "scripts": {
    "start": "tsx src/main.tsx",
    "check": "tsc",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "LGPL-3.0-or-later",
  "private": true,
  "dependencies": {
    "@vvo/tzdb": "^6.204.0",
    "ink": "^8.0.0",
    "moment-timezone": "^0.6.6",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
