# Julia
LocalPreferences.toml
.CondaPkg/
docs/build/
*.cov
*.jl.mem
deps/deps.jl

# Editor / OS
.vscode/
.idea/
.DS_Store

# Local agent instructions
CLAUDE.md
.claude/

# Python (py/FormFact_py.py is the only Python; env is managed by CondaPkg)
__pycache__/
*.py[codz]
.venv/

# non-open source papers
sources/

# cache
_cache/

# manuscript
manuscript/

# benchmark runs that are not baselines (test/baselines/README.md)
test/baselines/results/

# generated by docs/make.jl from the READMEs (edit the README, not the copy)
docs/src/guides/
docs/src/testing/
docs/src/index.md

# Generated fitting-test reports and plots: the workbook, every file of a plots/ folder
# (the .tex and what bb render-plots makes from it: pdf, png, svg, jpeg, logs), the
# half-written workbook, the tab-separated tables.
test/fitting_tests/plots/
test/fitting_tests/**/plots/
test/fitting_tests/**/*.part
test/fitting_tests/**/*.png
test/fitting_tests/**/*.pdf
test/fitting_tests/**/*.xlsx
test/fitting_tests/**/*.tex
test/fitting_tests/**/*.tsv
test/fitting_tests/**/*.txt

# the run log of a fitting test is tracked (small: what a benchmark needs, see
# BAYSOL.write_log); the upper-case suffix keeps it clear of the LaTeX `*.log` rule below,
# and the exception is for a case-insensitive file system
!test/fitting_tests/**/*.LOG

# not sure why R History keeps popping up but removing it
.Rhistory

# Transient files generated by babashka
.babashka*

# Generated visualization surfaces
/test/visualize/xyz/*.xyz

# clj-kondo: analysis cache, and the library configs an editor's clojure-lsp copies in
# (the one tracked file is .clj-kondo/config.edn)
.clj-kondo/.cache
.clj-kondo/imports/

# clojure-lsp cache (the editor creates it on opening the project)
.lsp/.cache/

# LaTeX build files (bb render-plots and any LaTeX run)
# Core LaTeX auxiliary files
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2
.*.lb

# Intermediate documents
*.dvi
*.xdv
-converted-to.*

# Bibliography auxiliary files
*.bbl
*.bcf
*.blg
-blx.aux
-blx.bib
*.run.xml

# Build tool auxiliary/directories
*.fdb_latexmk
*.synctex
*.synctex.gz
*.pdfsync
*.rubbercache
latex.out/

# Package auxiliary files
*.glo
*.gls
*.idx
*.ilg
*.ind
*.ist

# ...but fixtures keep their data files (SASDA52's pddf/*.out is a tracked fixture, a
# program output and no LaTeX file)
!test/fixtures/**/*.out

# the Clojure CLI classpath cache of the TUI project
tui/.cpcache/
