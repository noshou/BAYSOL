{
    // Unused dependencies, files and exports of the TypeScript side (`bysl precommit`, step
    // `ts-unused`). The terminal interface is the `tui` workspace; the root only carries the
    // linter that `bysl fmt` runs.
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    "workspaces": {
        ".": {
            // Biome is run by the dev tools (`bysl fmt`), not imported by any file, so it
            // looks unused to a scan of the code. `postject` is the binary that `bysl pkg` runs
            // (`node_modules/.bin/postject`) to inject the blob into the Node executable.
            "ignoreDependencies": ["@biomejs/biome", "postject"]
        },
        "tui": {
            // `frame-worker.ts` is started by `new Worker(new URL(...))` in `store/frame-render.ts`,
            // which knip does not follow
            "entry": ["test/*.test.ts", "test/support/*.ts", "dev/*.ts", "src/store/frame-worker.ts"],
            "project": ["src/**/*.{ts,tsx}", "test/**/*.ts", "dev/**/*.ts"],
            // `reg` is the Windows registry tool that `core/fonts.ts` runs on Windows;
            // `pdftocairo` is poppler's, run by the sixel rasteriser (optional, found at run time);
            // `7z` unpacks the fixture archives in `test/data.test.ts`
            "ignoreBinaries": ["reg", "pdftocairo", "7z"],
            // `@resvg/resvg-js` is loaded by a specifier that is not a literal
            // (`store/sixel-raster.ts`), which knip cannot follow
            "ignoreDependencies": ["@resvg/resvg-js"]
        }
    }
}
