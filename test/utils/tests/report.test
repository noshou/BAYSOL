# SPDX-License-Identifier: LGPL-2.1-or-later

# Tests of report.tcl: one real report in the current format and one in the v0.2.0 format (which lacks the
# MAP-search lines), with every parsed field checked.

source [file join [file dirname [info script]] helpers.tcl]
source [file join $UTILS_DIR common.tcl]
source [file join $UTILS_DIR report.tcl]

proc fields {file keys} {
    set d [report::parse [util::slurp [file join $::DATA_DIR $file]]]
    set out {}
    foreach k $keys { lappend out [dict get $d $k] }
    return $out
}

test parse-current {the current report format} -body {
    fields res_current.txt {chi2 c1 sat rho_e d1 d2 d3 div steps depth accept ebfmi wall fwd map_s reprofile gc leapfrog ms_step nuts z3 n_modes wall_ex}
} -result {+0.868097 +1.2486 false +0.336156 -1.09317 +1.95561 -5.67044 0.0000 5.70 2.52 0.9019 0.9579 15.37 2.67 3.05 0.68 4.2 12170.0 0.5 6.11 -0.792701 2 15.37}

test parse-v0.2.0 {the v0.2.0 format: fields it lacks are empty, the others parse} -body {
    fields res_v020.txt {chi2 c1 d1 d2 d3 steps wall fwd map_s n_modes leapfrog nuts z3 wall_ex}
} -result {+1.13124 +1.12324 +1.97557 -2.15674 -9.83588 6.18 56.43 24.17 {} {} 15200.0 27.27 -2.11641 56.43}

test parse-shannon {a Shannon-binned report: chi2 is the fit's own, chi2_raw the measured-grid one, chi2_cmp the latter} -body {
    fields res_shannon.txt {chi2 chi2_raw chi2_cmp c1 d3}
} -result {+0.912345 0.951234 0.951234 +1.2486 -5.67044}

test chi2-cmp-without-raw {an older report has no measured-grid line: chi2_cmp falls back to chi2} -body {
    fields res_current.txt {chi2_raw chi2_cmp}
} -result {{} +0.868097}

test count {iteration and leapfrog counts with k and M suffixes} -body {
    list [report::count 496.68k] [report::count 12.4k] [report::count 1.2M] [report::count 750]
} -result {496680.0 12400.0 1200000.0 750.0}

test orzero {empty means zero} -body {
    list [report::orzero {}] [report::orzero 3.5]
} -result {0 3.5}

test number-trap {a number capture keeps all its digits (no lazy quantifier in front of it)} -body {
    report::grab "mean_n_steps   = 215.45" {^mean_n_steps\s+= @N@}
} -result 215.45

cleanupTests
