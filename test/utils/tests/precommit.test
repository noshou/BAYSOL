# SPDX-License-Identifier: LGPL-2.1-or-later

# Tests of precommit.tcl's whitespace step on a scratch git repository: trailing whitespace on changed lines is stripped
# (and only there), untracked files are stripped whole, a conflict marker is a failure.

source [file join [file dirname [info script]] helpers.tcl]
source [file join $REPO_DIR test run precommit.tcl]

# a scratch repository with one committed file ("a.jl": three lines, the second already ends in blanks)
proc scratch_repo {} {
    set dir [file normalize [file join [info script] .. scratch-precommit-[pid]]]
    file delete -force $dir
    file mkdir $dir
    exec git -C $dir init -q
    set ch [open [file join $dir a.jl] w]
    puts -nonewline $ch "one\ntwo  \nthree\n"
    close $ch
    exec git -C $dir add a.jl
    exec git -C $dir -c user.name=t -c user.email=t@t commit -q -m init
    return $dir
}

proc read_file {path} {
    set ch [open $path r]
    set text [read $ch]
    close $ch
    return $text
}

test whitespace-strips-only-changed-lines {changed and untracked lines are stripped, a line git did not see change is not} -body {
    set dir [scratch_repo]
    set ::ROOT $dir
    set ch [open [file join $dir a.jl] w]
    puts -nonewline $ch "one \ntwo  \nthree\t\nfour\n"      ;# lines 1 and 3 changed with blanks, line 2 untouched
    close $ch
    set ch [open [file join $dir new.md] w]
    puts -nonewline $ch "x  \ny\n"
    close $ch
    set ok [precommit::whitespace]
    set a [read_file [file join $dir a.jl]]
    set b [read_file [file join $dir new.md]]
    file delete -force $dir
    list $ok [string map {\n |} $a] [string map {\n |} $b]
} -result {1 {one|two  |three|four|} x|y|}

test whitespace-conflict-marker-fails {a conflict marker in an untracked file is reported and fails} -body {
    set dir [scratch_repo]
    set ::ROOT $dir
    set ch [open [file join $dir b.jl] w]
    puts -nonewline $ch "ok\n<<<<<<< HEAD\nx\n"
    close $ch
    set ok [precommit::whitespace]
    file delete -force $dir
    set ok
} -result 0

test whitespace-clean-tree {nothing to strip: true and the files are byte for byte the same} -body {
    set dir [scratch_repo]
    set ::ROOT $dir
    set before [read_file [file join $dir a.jl]]
    set ok [precommit::whitespace]
    set same [expr {[read_file [file join $dir a.jl]] eq $before}]
    file delete -force $dir
    list $ok $same
} -result {1 1}

cleanupTests
