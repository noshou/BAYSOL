;; A custom-solutes.edn (global, in the BAYSOL data folder next to settings.edn) with an
;; entry of every kind, the schema the TUI's custom store reads and writes. Row keys:
;;   :kind :nonbiological  :name :formula :z :pmv :sigma     (:sigma nil = the PMV fallback)
;;   :kind :polymer        :name :units :z-ends :pmv-ends :sigma-ends
;;       :units is 1 to 4 of {:label :formula :z :slope :sigma}: the kind of repeat unit
;;       (a label the user chooses, its formula, electrons per unit, PMV per unit, absolute
;;       sigma per unit or nil); :z-ends and :pmv-ends are the end groups' electrons and PMV
;;       (typed by the user, no default), :sigma-ends their sigma or nil.
;; PMV in cm3/mol at 25 C, sigma absolute.
{:solutes
 [{:kind :nonbiological,
   :name "N-acetylcysteine ethyl ester",
   :formula "C7H13NO3S",
   :z 102,
   :pmv 118.4,
   :sigma 4.0}
  {:kind :nonbiological,
   :name "ammonium nitrate",
   :formula "NH4+ NO3-",
   :z 32,
   :pmv 46.7,
   :sigma nil}
  {:kind :polymer,
   :name "chain-1",
   :units [{:label "A", :formula "C2H4O", :z 24, :slope 36.73, :sigma nil}],
   :z-ends 10,
   :pmv-ends 19.24,
   :sigma-ends nil}
  {:kind :polymer,
   :name "chain-4",
   :units [{:label "A", :formula "C2H4O", :z 10, :slope 1.0, :sigma nil}
    {:label "B", :formula "C3H6O", :z 20, :slope 2.0, :sigma 0.1}
    {:label "C", :formula "C4H8O", :z 30, :slope 3.0, :sigma nil}
    {:label "D", :formula "C5H10O", :z 40, :slope 4.0, :sigma 0.2}],
   :z-ends 5,
   :pmv-ends 7.0,
   :sigma-ends 0.5}]}
