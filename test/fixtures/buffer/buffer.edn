;; A buffer.edn with a row of every kind, the one schema both sides are tested against: the
;; TUI (tui/src/baysol/tui/buffer.clj and its tests) writes and validates it, the Julia
;; loader (BAYSOL.Pipeline.load_buffer, test_loadbuffer.jl) reads it. Concentrations are in
;; mM as typed; the loader divides by 1000 (BAYSOL takes mol/L). Row keys:
;;   :kind          :nonbiological :polymer :dna :rna :protein :custom-nonbio
;;                  :custom-polymer
;;   :name          what the user calls the row (any text; for the loader only a label)
;;   :arg           what BAYSOL is given: a table name (:nonbiological), a grade or a family
;;                  string exactly as `Polymer` takes it (:polymer), a clean sequence
;;                  (:dna :rna :protein)
;;   :mM :sigma-mM  concentration and its standard uncertainty, mM, required, :mM above 0
;;   custom rows carry a SNAPSHOT of the custom entry (the project never reads the global
;;   custom-solutes.edn): :custom-nonbio has :custom :z :pmv :sigma-pmv (nil = the
;;   fallback);
;;   :custom-polymer has :custom :units (1 to 4 of {:label :formula :z :slope :sigma}),
;;   :z-ends :pmv-ends :sigma-ends (nil = none) and :counts, one number per unit, in order.
;; :source and :record (file name and record id of a sequence) are provenance only.
{:solutes
 [{:kind :nonbiological,
   :name "NaCl",
   :arg "sodium chloride",
   :mM 200.0,
   :sigma-mM 10.0}
  {:kind :polymer, :name "PEG 3350", :arg "PEG 3350", :mM 0.05, :sigma-mM 0.003}
  {:kind :polymer, :name "PEG 22", :arg "PEG n=22", :mM 0.1, :sigma-mM 0.01}
  {:kind :polymer,
   :name "Pluronic",
   :arg "Pluronic nEO=100 nPO=65",
   :mM 0.01,
   :sigma-mM 0.001}
  {:kind :dna,
   :name "primer-A",
   :arg "ACGTTGCA",
   :source "primer.fasta",
   :record "p1",
   :mM 0.01,
   :sigma-mM 0.001}
  {:kind :rna,
   :name "guide",
   :arg "ACGUUGCA",
   :source "guide.fa",
   :record "g1",
   :mM 0.02,
   :sigma-mM 0.002}
  {:kind :protein,
   :name "carrier",
   :arg "MKTAYIAKQR",
   :source "carrier.fa",
   :record "sp|P1",
   :mM 0.02,
   :sigma-mM 0.002}
  {:kind :custom-nonbio,
   :name "NACET",
   :custom "N-acetylcysteine ethyl ester",
   :z 102,
   :pmv 118.4,
   :sigma-pmv 4.0,
   :mM 5.0,
   :sigma-mM 0.1}
  {:kind :custom-nonbio,
   :name "ammonium nitrate",
   :custom "ammonium nitrate",
   :z 32,
   :pmv 46.7,
   :sigma-pmv nil,
   :mM 10.0,
   :sigma-mM 0.2}
  {:kind :custom-polymer,
   :name "one-unit chain",
   :custom "chain-1",
   :units [{:label "A", :formula "C2H4O", :z 24, :slope 36.73, :sigma nil}],
   :z-ends 10,
   :pmv-ends 19.24,
   :sigma-ends nil,
   :counts [22.0],
   :mM 0.01,
   :sigma-mM 0.0001}
  {:kind :custom-polymer,
   :name "four-unit chain",
   :custom "chain-4",
   :units [{:label "A", :formula "C2H4O", :z 10, :slope 1.0, :sigma nil}
    {:label "B", :formula "C3H6O", :z 20, :slope 2.0, :sigma 0.1}
    {:label "C", :formula "C4H8O", :z 30, :slope 3.0, :sigma nil}
    {:label "D", :formula "C5H10O", :z 40, :slope 4.0, :sigma 0.2}],
   :z-ends 5,
   :pmv-ends 7.0,
   :sigma-ends 0.5,
   :counts [3.0 4.0 5.0 6.0],
   :mM 0.01,
   :sigma-mM 0.0001}]}
